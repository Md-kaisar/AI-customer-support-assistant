# --- Chat / generation ---
# Option A (default): OpenAI directly.
#   CHAT_API_KEY=sk-proj-your-real-openai-key
#   CHAT_BASE_URL=
#   CHAT_MODEL=gpt-4o-mini
#
# Option B: OpenRouter (free tier available, no billing required).
#   1. Sign up at https://openrouter.ai and create a key (Keys page).
#   2. Pick a currently-free model from https://openrouter.ai/models?max_price=0
#      -- the free lineup rotates, so check the live list rather than trusting
#      an old example. IDs end in ":free", e.g. "openai/gpt-oss-120b:free".
#   3. Fill in below:
CHAT_API_KEY=sk-or-v1-your-openrouter-key-here
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-oss-120b:free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=AI Customer Support Assistant

# --- Embeddings (knowledge-base retrieval) ---
# Default: runs 100% locally via Chroma's bundled model. No key, no cost,
# works regardless of which chat provider you use above.
USE_LOCAL_EMBEDDINGS=true
EMBEDDING_MODEL=text-embedding-3-small

# --- Voice (optional; Whisper transcription + TTS) ---
# ONLY needed if you want to use /voice. Requires a real, billed OpenAI key --
# OpenRouter does not support the audio endpoints. Leave blank to skip voice;
# /chat works fully without this.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- MongoDB (conversation memory) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=support_ai

# --- Vector store (Chroma) ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=kb_docs
RETRIEVAL_TOP_K=3

# --- Conversation memory ---
MAX_HISTORY_TURNS=8

# --- Escalation ---
ESCALATION_CONFIDENCE_THRESHOLD=0.55

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
